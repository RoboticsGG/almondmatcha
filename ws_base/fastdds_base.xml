<?xml version="1.0" encoding="UTF-8" ?>
<!--
  fastdds_base.xml — Fast-DDS profile for ws_base
  Set via: export FASTRTPS_DEFAULT_PROFILES_FILE=~/almondmatcha/ws_base/fastdds_base.xml

  Multi-base-PC support:
    One active base machine at a time is supported. The active base PC can use
    any IP from the approved pool: 192.168.1.4, 192.168.1.10, 192.168.1.11.

  Problem solved:
    A base PC may have multiple NICs (Ethernet + WiFi). Fast-DDS can pick WiFi
    and miss SPDP from rover participants on 192.168.1.0/24.

  Fix:
    1. UDPv4 transport restricted to approved rover-Ethernet base IPs.
    2. metatrafficMulticastLocatorList + initialPeersList include 239.255.0.1:8650
       so FastDDS joins STM32 SPDP multicast discovery.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <transport_descriptors>
    <transport_descriptor>
      <transport_id>rover_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.1.4</address>
        <address>192.168.1.10</address>
        <address>192.168.1.11</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>rover_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>

      <builtin>
        <metatrafficMulticastLocatorList>
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>8650</port>
            </udpv4>
          </locator>
        </metatrafficMulticastLocatorList>

        <initialPeersList>
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>8650</port>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.1</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.2</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.5</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.6</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>

</profiles>
