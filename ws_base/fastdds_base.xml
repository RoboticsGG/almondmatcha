<?xml version="1.0" encoding="UTF-8" ?>
<!--
  fastdds_base.xml — Fast-DDS profile for ws_base single-domain POC
  Set via: export FASTRTPS_DEFAULT_PROFILES_FILE=~/almondmatcha/ws_base/fastdds_base.xml

  Problem solved:
    ws_base has two active NICs: enp0s31f6 (192.168.1.4, rover Ethernet)
    and wlp4s0 (172.30.81.x, WiFi).  Fast-DDS may pick WiFi as primary
    interface and miss SPDP from all rover participants on 192.168.1.0/24.

  Fix:
    1. UDPv4 transport restricted to 192.168.1.4 (enp0s31f6 only).
    2. initialPeersList includes the SPDP multicast group (239.255.0.1:8650)
       so FastDDS joins and receives STM32 announcements regardless of when
       the boards booted. All unicast peer IPs are also listed for fast
       discovery when boards boot at the same time as Linux nodes.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!-- ── Transport: restrict to rover Ethernet interface only ── -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>rover_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.1.4</address>   <!-- enp0s31f6 — rover Ethernet -->
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <!-- ── Participant: use rover transport + add rover unicast peers ── -->
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>rover_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>

      <builtin>
        <initialPeersList>
          <!-- Multicast entry retained so FastDDS joins the SPDP multicast group
               and can receive announcements from STM32 boards that were already
               running before the Linux nodes started (e.g. not power-cycled).
               Port 8650 = DDS SPDP port for domain 5 (7400 + 250*5). -->
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>8650</port>
            </udpv4>
          </locator>
          <!-- RPi (thehive) -->
          <locator>
            <udpv4>
              <address>192.168.1.1</address>
            </udpv4>
          </locator>
          <!-- STM32 chassis-dynamics board -->
          <locator>
            <udpv4>
              <address>192.168.1.2</address>
            </udpv4>
          </locator>
          <!-- Jetson -->
          <locator>
            <udpv4>
              <address>192.168.1.5</address>
            </udpv4>
          </locator>
          <!-- STM32 sensors-gnss board -->
          <locator>
            <udpv4>
              <address>192.168.1.6</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>

</profiles>
