<?xml version="1.0" encoding="UTF-8" ?>
<!--
  fastdds_rover.xml — Fast-DDS profile for ws_rpi single-domain POC
  Set via: export FASTRTPS_DEFAULT_PROFILES_FILE=~/almondmatcha/ws_rpi/fastdds_rover.xml

  Problem solved:
    The RPi (thehive) may have multiple NICs (Ethernet 192.168.1.1 + optional WiFi).
    Fast-DDS may pick the wrong interface and miss SPDP from rover participants.

  Fix:
    1. UDPv4 transport restricted to 192.168.1.1 (rover Ethernet only).
    2. initialPeersList uses unicast-only (no multicast group entry).
       All participant IPs are statically known so unicast SPDP is both
       simpler and more predictable than multicast.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!-- ── Transport: restrict to rover Ethernet interface only ── -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>rover_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.1.1</address>   <!-- RPi (thehive) rover Ethernet -->
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <!-- ── Participant: use rover transport + add all rover unicast peers ── -->
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>rover_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>

      <builtin>
        <initialPeersList>
          <!-- No multicast entry: all participant IPs are known statically.
               Unicast-only SPDP is sufficient and deterministic when the STM32
               mros2 stack spins immediately on boot. -->
          <!-- STM32 chassis-dynamics board -->
          <locator>
            <udpv4>
              <address>192.168.1.2</address>
            </udpv4>
          </locator>
          <!-- ws_base -->
          <locator>
            <udpv4>
              <address>192.168.1.4</address>
            </udpv4>
          </locator>
          <!-- Jetson -->
          <locator>
            <udpv4>
              <address>192.168.1.5</address>
            </udpv4>
          </locator>
          <!-- STM32 sensors-gnss board -->
          <locator>
            <udpv4>
              <address>192.168.1.6</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>

</profiles>
