<?xml version="1.0" encoding="UTF-8" ?>
<!--
  fastdds_rover.xml — Fast-DDS profile for ws_rpi single-domain POC
  Set via: export FASTRTPS_DEFAULT_PROFILES_FILE=~/almondmatcha/ws_rpi/fastdds_rover.xml

  Problem solved:
    The RPi (thehive) may have multiple NICs (Ethernet 192.168.1.1 + optional WiFi).
    Fast-DDS may pick the wrong interface and miss SPDP from rover participants.

  Fix:
    1. UDPv4 transport restricted to 192.168.1.1 (rover Ethernet only).
    2. initialPeersList includes the SPDP multicast group (239.255.0.1:8650)
       so FastDDS joins and receives STM32 announcements regardless of when
       the boards booted (embeddedRTPS only supports multicast discovery).
       Unicast peer IPs are listed for Linux-to-Linux FastDDS discovery.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!-- ── Transport: restrict to rover Ethernet interface only ── -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>rover_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.1.1</address>   <!-- RPi (thehive) rover Ethernet -->
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <!-- ── Participant: use rover transport + add all rover unicast peers ── -->
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>rover_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>

      <builtin>
        <!-- metatrafficMulticastLocatorList: tells FastDDS to JOIN the SPDP
             multicast group for RECEIVING announcements. Without this,
             useBuiltinTransports=false means no multicast reception —
             initialPeersList only controls where SPDP is SENT TO.
             Port 8650 = DDS SPDP port for domain 5 (7400 + 250*5). -->
        <metatrafficMulticastLocatorList>
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>8650</port>
            </udpv4>
          </locator>
        </metatrafficMulticastLocatorList>
        <initialPeersList>
          <!-- Unicast peers for direct SPDP + multicast for belt-and-suspenders -->
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>8650</port>
            </udpv4>
          </locator>
          <!-- STM32 chassis-dynamics board -->
          <locator>
            <udpv4>
              <address>192.168.1.2</address>
            </udpv4>
          </locator>
          <!-- ws_base -->
          <locator>
            <udpv4>
              <address>192.168.1.4</address>
            </udpv4>
          </locator>
          <!-- Jetson -->
          <locator>
            <udpv4>
              <address>192.168.1.5</address>
            </udpv4>
          </locator>
          <!-- STM32 sensors-gnss board -->
          <locator>
            <udpv4>
              <address>192.168.1.6</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>

</profiles>
