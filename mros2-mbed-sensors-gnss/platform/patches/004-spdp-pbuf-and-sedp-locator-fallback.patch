   constexpr static pbuf_type m_type = PBUF_POOL;
 
   DataSize_t m_freeSpace = 0;
diff --git a/src/discovery/SPDPAgent.cpp b/src/discovery/SPDPAgent.cpp
index 562d1b5..68ecfda 100644
--- a/src/discovery/SPDPAgent.cpp
+++ b/src/discovery/SPDPAgent.cpp
@@ -165,6 +165,8 @@ void SPDPAgent::processProxyData() {
   if (mp_participant->addNewRemoteParticipant(m_proxyDataBuffer)) {
     addProxiesForBuiltInEndpoints();
     m_buildInEndpoints.spdpWriter->setAllChangesToUnsent();
+    m_buildInEndpoints.sedpPubWriter->setAllChangesToUnsent();
+    m_buildInEndpoints.sedpSubWriter->setAllChangesToUnsent();
 #if SPDP_VERBOSE && RTPS_GLOBAL_VERBOSE
     SPDP_LOG("Added new participant with guid: ");
     printGuidPrefix(m_proxyDataBuffer.m_guid.prefix);
@@ -194,6 +196,35 @@ bool SPDPAgent::addProxiesForBuiltInEndpoints() {
     }
   }
 
+  // Fallback 1: Use metatraffic multicast locator if available.
+  // FastDDS with explicit metatrafficMulticastLocatorList does NOT bind
+  // metatraffic unicast ports — all SEDP goes via multicast (port 8650).
+  if (!locator) {
+    for (unsigned int i = 0;
+         i < m_proxyDataBuffer.m_metatrafficMulticastLocatorList.size(); i++) {
+      LocatorIPv4 *l = &(m_proxyDataBuffer.m_metatrafficMulticastLocatorList[i]);
+      if (l->isValid() && l->isMulticastAddress()) {
+        locator = l;
+        break;
+      }
+    }
+  }
+
+  // Fallback 2: Derive metatraffic port from default unicast port (port - 1).
+  static LocatorIPv4 derivedMetaLoc;
+  if (!locator) {
+    for (unsigned int i = 0;
+         i < m_proxyDataBuffer.m_defaultUnicastLocatorList.size(); i++) {
+      LocatorIPv4 *l = &(m_proxyDataBuffer.m_defaultUnicastLocatorList[i]);
+      if (l->isValid() && l->isSameSubnet()) {
+        derivedMetaLoc = *l;
+        derivedMetaLoc.port = l->port - 1; // D3-D1=1 in RTPS port mapping
+        locator = &derivedMetaLoc;
+        break;
+      }
+    }
+  }
+
   if (!locator) {
     return false;
   }
