--- a/include/rtps/storages/PBufWrapper.h
+++ b/include/rtps/storages/PBufWrapper.h
@@ -68,7 +68,7 @@ struct PBufWrapper {
   DataSize_t spaceUsed() const;
 
 private:
-  constexpr static pbuf_layer m_layer = PBUF_TRANSPORT;
