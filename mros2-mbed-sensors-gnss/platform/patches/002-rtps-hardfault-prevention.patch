 using rtps::MessageReceiver;
 
 #if RECV_VERBOSE && RTPS_GLOBAL_VERBOSE
@@ -55,13 +57,32 @@ void MessageReceiver::resetState() {
 
 bool MessageReceiver::processMessage(const uint8_t *data, DataSize_t size) {
   resetState();
-  MessageProcessingInfo msgInfo(data, size);
+
+  // --- NUCLEO-F767ZI HardFault prevention ---
+  // Copy packet data into our dedicated member buffer before processing.
+  // This decouples the parser from the lwip pbuf payload pointer and places
+  // the data at a stable, known BSS address.  Guard words bracket the buffer
+  // to detect memory corruption from deep SPDP/SEDP callback chains.
+  if (size == 0 || size > RECV_BUFFER_SIZE) {
+    return false;
+  }
+
+  m_guardPre  = GUARD_MAGIC;
+  m_guardPost = GUARD_MAGIC;
+  memcpy(m_recvBuffer, data, size);
+
+  MessageProcessingInfo msgInfo(m_recvBuffer, size);
 
   if (!processHeader(msgInfo)) {
     return false;
   }
   SubmessageHeader submsgHeader;
   while (msgInfo.nextPos < msgInfo.size) {
+    // Check guard words: if a callback chain overwrote adjacent memory,
+    // abort immediately instead of processing with corrupted state.
+    if (m_guardPre != GUARD_MAGIC || m_guardPost != GUARD_MAGIC) {
+      return false;
+    }
     if (!deserializeMessage(msgInfo, submsgHeader)) {
       return false;
     }
diff --git a/src/messages/MessageTypes.cpp b/src/messages/MessageTypes.cpp
index 693105d..47163b2 100644
--- a/src/messages/MessageTypes.cpp
+++ b/src/messages/MessageTypes.cpp
@@ -24,11 +24,35 @@ Author: i11 - Embedded Software, RWTH Aachen University
 
 #include "rtps/messages/MessageTypes.h"
 #include <cstring>
+#include <cstdint>
 
 #include <stdio.h>
 using namespace rtps;
 
+// ---- NUCLEO-F767ZI (STM32F767ZI) memory map ----
+// DTCM RAM : 0x20000000 - 0x2001FFFF  (128 KB)
+// SRAM1    : 0x20020000 - 0x2007BFFF  (368 KB)
+// SRAM2    : 0x2007C000 - 0x2007FFFF  (16  KB)
+// Flash    : 0x08000000 - 0x081FFFFF  (2   MB)
+// This board has NO external SDRAM/FMC memory.
+static inline bool isValidReadPtr(const uint8_t *p, size_t len) {
+  uintptr_t addr = reinterpret_cast<uintptr_t>(p);
+  uintptr_t end  = addr + len;
+  // Contiguous internal SRAM (DTCM + SRAM1 + SRAM2)
+  if (addr >= 0x20000000u && end <= 0x20080000u) return true;
+  // Internal Flash (2 MB)
+  if (addr >= 0x08000000u && end <= 0x08200000u) return true;
+  return false;
+}
+
 void doCopyAndMoveOn(uint8_t *dst, const uint8_t *&src, size_t size) {
+  if (!isValidReadPtr(src, size)) {
+    // Pointer outside NUCLEO-F767ZI SRAM/Flash — skip copy to prevent
+    // HardFault (BusFault on unmapped FMC/peripheral space, or UsageFault
+    // on unaligned odd address).
+    src += size;
+    return;
+  }
   memcpy(dst, src, size);
   src += size;
 }
