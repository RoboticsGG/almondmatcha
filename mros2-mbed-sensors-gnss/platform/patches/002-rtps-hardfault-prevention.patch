diff --git a/include/rtps/messages/MessageReceiver.h b/include/rtps/messages/MessageReceiver.h
index c7af703..72d0e78 100644
--- a/include/rtps/messages/MessageReceiver.h
+++ b/include/rtps/messages/MessageReceiver.h
@@ -47,9 +47,21 @@ public:
 
   bool processMessage(const uint8_t *data, DataSize_t size);
 
+  // --- NUCLEO-F767ZI HardFault prevention ---
+  // Dedicated receive buffer: packet data is copied here before processing,
+  // decoupling the parser from the lwip pbuf payload pointer.  Guard words
+  // bracket the buffer to detect memory corruption from deep SPDP/SEDP
+  // callback chains during single-domain discovery bursts.
+  static constexpr uint16_t RECV_BUFFER_SIZE = 1536; // max Ethernet frame payload
+  static constexpr uint32_t GUARD_MAGIC = 0xDEADC0DE;
+
 private:
   Participant *mp_part;
 
+  volatile uint32_t m_guardPre  = GUARD_MAGIC;
+  uint8_t  m_recvBuffer[RECV_BUFFER_SIZE];
+  volatile uint32_t m_guardPost = GUARD_MAGIC;
+
   void resetState();
 
   // TODO make msgInfo a member
