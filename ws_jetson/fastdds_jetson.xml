<?xml version="1.0" encoding="UTF-8"?>
<!--
  fastdds_jetson.xml — Fast-DDS profile for ws_jetson (192.168.1.5)

  Multi-base-PC support:
    Any one active base PC can use one of the approved base IPs:
    192.168.1.4, 192.168.1.10, 192.168.1.11.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <transport_descriptors>
    <transport_descriptor>
      <transport_id>rover_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.1.5</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>rover_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>

      <builtin>
        <metatrafficMulticastLocatorList>
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>8650</port>
            </udpv4>
          </locator>
        </metatrafficMulticastLocatorList>

        <initialPeersList>
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>8650</port>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.1</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.2</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.4</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.10</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.11</address>
            </udpv4>
          </locator>
          <locator>
            <udpv4>
              <address>192.168.1.6</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>

</profiles>
