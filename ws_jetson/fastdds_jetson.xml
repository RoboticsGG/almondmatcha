<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast-DDS profile for ws_jetson (Jetson, 192.168.1.5).

  Purpose:
    1. UDPv4 transport restricted to 192.168.1.5 (rover Ethernet only).
    2. initialPeersList adds all rover participants as unicast peers so
       discovery succeeds even if multicast is unreliable on the segment.

  Usage:
    export FASTRTPS_DEFAULT_PROFILES_FILE=~/almondmatcha/ws_jetson/fastdds_jetson.xml
    (added automatically by launch_jetson_single_domain.sh)
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!-- ── Transport: bind to rover Ethernet interface only ── -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>rover_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.1.5</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <!-- ── Participant: use rover transport + add all rover unicast peers ── -->
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>rover_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>

      <builtin>
        <initialPeersList>
          <!-- Multicast entry retained so FastDDS joins the SPDP multicast group
               and can receive announcements from STM32 boards that were already
               running before the Linux nodes started (e.g. not power-cycled).
               Port 8650 = DDS SPDP port for domain 5 (7400 + 250*5). -->
          <locator>
            <udpv4>
              <address>239.255.0.1</address>
              <port>8650</port>
            </udpv4>
          </locator>
          <!-- RPi (thehive) -->
          <locator>
            <udpv4>
              <address>192.168.1.1</address>
            </udpv4>
          </locator>
          <!-- STM32 chassis-dynamics board -->
          <locator>
            <udpv4>
              <address>192.168.1.2</address>
            </udpv4>
          </locator>
          <!-- ws_base -->
          <locator>
            <udpv4>
              <address>192.168.1.4</address>
            </udpv4>
          </locator>
          <!-- STM32 sensors-gnss board -->
          <locator>
            <udpv4>
              <address>192.168.1.6</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>

</profiles>
